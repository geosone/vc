F1:	ZIP-Menue...
	zip.mnu
F2:	ARJ-Menue...
	arj.mnu
F3:	ACE-Menue...
	ace.mnu
Z:	Compress with ZIP
	PKZIP -Pex -whs !~ @!~@
A:	Compress with ARJ
	ARJ A !~ !!!~@
L:	Compress with LHA
	LHA A -x !~ @!~@
C:	Create the list of files
	@ECHO The list of files was created in VC.LST file
	@COPY !~@ VC.LST > nul
F10:	Main Menu
	vc.mnu
